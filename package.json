{
  "name": "autodefaultslicer",
  "version": "1.9.0",
  "description": "A native-like Power BI slicer with dynamic default selection (Max / Min / None), Single / Single-or-All / Multi modes, Sort By support, and Power BI Report Server compatibility.",
  "private": true,
  "license": "MIT",
  "author": "Neoblastergx",
  "homepage": "https://github.com/Neoblastergx/AutoDefaultSlicer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neoblastergx/AutoDefaultSlicer.git"
  },
  "bugs": {
    "url": "https://github.com/Neoblastergx/AutoDefaultSlicer/issues"
  },
  "keywords": [
    "power-bi",
    "powerbi",
    "power-bi-custom-visual",
    "pbiviz",
    "power-bi-report-server",
    "slicer",
    "custom-visual",
    "typescript",
    "business-intelligence"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "package": "pbiviz package && node tests/bundle.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "node build-tests.mjs && node .tmp/test/acceptance.cjs && node .tmp/test/session.cjs && node .tmp/test/dom.cjs",
    "test:logic": "node build-tests.mjs && node .tmp/test/acceptance.cjs",
    "test:dom": "node build-tests.mjs && node .tmp/test/dom.cjs",
    "test:session": "node build-tests.mjs && node .tmp/test/session.cjs",
    "test:bundle": "node tests/bundle.cjs"
  },
  "dependencies": {
    "powerbi-models": "2.1.1",
    "powerbi-visuals-api": "5.3.0",
    "powerbi-visuals-utils-formattingutils": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "esbuild": "^0.24.2",
    "eslint": "9.17.0",
    "eslint-plugin-powerbi-visuals": "1.0.0",
    "jsdom": "^25.0.1",
    "powerbi-visuals-tools": "5.6.0",
    "typescript": "5.4.5"
  }
}
