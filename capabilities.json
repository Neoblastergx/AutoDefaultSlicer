{
  "privileges": [],
  "supportsHighlight": false,
  "supportsKeyboardFocus": true,
  "supportsLandingPage": false,
  "supportsSynchronizingFilterState": true,
  "suppressDefaultTitle": true,
  "dataRoles": [
    {
      "displayName": "Value",
      "name": "value",
      "kind": "Grouping",
      "description": "Column shown in the slicer and used to filter the model. Exactly one column."
    },
    {
      "displayName": "Sort By",
      "name": "sortBy",
      "kind": "Grouping",
      "description": "Optional. Used only to order the items and to resolve the Max / Min default. At most one column."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "value": {
            "min": 1,
            "max": 1
          },
          "sortBy": {
            "min": 0,
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "value"
              }
            },
            {
              "for": {
                "in": "sortBy"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "objects": {
